{
  "name": "whisper-npu",
  "version": "1.0.1",
  "description": "Brings speech-to-text to any app at cursor via global hotkey using Whisper on NPU",
  "main": "dist/main.js",
  "bin": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "clean": "node scripts/clean.js",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "exe": "pkg .",
    "pack": "node scripts/pack.js",
    "release": "npm run clean && npm run build && npm run exe && npm run pack"
  },
  "keywords": [
    "whisper",
    "openvino",
    "npu",
    "speech-to-text",
    "voice-to-text",
    "global-hotkey",
    "speech-recognition"
  ],
  "author": "",
  "license": "MPL-2.0",
  "type": "commonjs",
  "dependencies": {
    "clipboardy": "^5.3.1",
    "global-hotkey": "^0.0.12",
    "node-fetch": "3.3.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/node-fetch": "^2.6.13",
    "@yao-pkg/pkg": "^6.14.2",
    "archiver": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "pkg": {
    "scripts": [
      "dist/main.js"
    ],
    "targets": [
      "node24-win"
    ],
    "assets": [
      "node_modules/**",
      "external/**"
    ]
  }
}
