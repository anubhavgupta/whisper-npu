{
  "name": "whisper-npu",
  "version": "1.0.0",
  "description": "Brings speech-to-text to any app via global hotkey using Whisper on NPU",
  "main": "dist/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true})\"",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts"
  },
  "keywords": [
    "whisper",
    "openvino",
    "npu",
    "speech-to-text",
