{
  "name": "whisper-npu",
  "version": "1.0.1",
  "description": "Brings speech-to-text to any app at cursor via global hotkey using Whisper on NPU",
  "main": "dist/main.js",
  "bin": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "clean": "node scripts/clean.js",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "exe": "npm run exe:engine && npm run build:tray",
    "pack": "node scripts/pack.js",
    "release": "npm run clean && npm run build && npm run exe && npm run pack",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:windows": "powershell.exe -NoProfile -NonInteractive -STA -ExecutionPolicy Bypass -File tests/windows-insertion.ps1",
    "exe:engine": "pkg . --output whisper-npu-engine.exe --no-bytecode --public-packages \"*\" --public",
    "build:tray": "node scripts/build-tray.js",
    "test:tray": "dotnet run --project tests/tray/TrayTests.csproj --configuration Release"
  },
  "keywords": [
    "whisper",
    "openvino",
    "npu",
    "speech-to-text",
    "voice-to-text",
    "global-hotkey",
    "speech-recognition"
  ],
  "author": "",
  "license": "MPL-2.0",
  "type": "commonjs",
  "dependencies": {
    "node-fetch": "3.3.2",
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/node-fetch": "^2.6.13",
    "@yao-pkg/pkg": "^6.14.2",
    "archiver": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "pkg": {
    "scripts": [
      "dist/main.js"
    ],
    "targets": [
      "node24-win-x64"
    ],
    "assets": [
      "node_modules/uiohook-napi/prebuilds/win32-x64/*.node"
    ]
  }
}
